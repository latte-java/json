project(group: "org.lattejava", name: "json", version: "0.1.0", licenses: ["MIT"]) {
  workflow {
    standard()
  }

  publishWorkflow {
    latte()
  }

  dependencies {
    group(name: "test-compile", export: false) {
      dependency(id: "org.testng:testng:7.12.0")
    }
  }

  publications {
    standard()
  }
}

// Plugins
dependency = loadPlugin(id: "org.lattejava.plugin:dependency:0.4.0")
file = loadPlugin(id: "org.lattejava.plugin:file:0.4.0")
idea = loadPlugin(id: "org.lattejava.plugin:idea:0.4.0")
java = loadPlugin(id: "org.lattejava.plugin:java:0.4.0")
javaTestNG = loadPlugin(id: "org.lattejava.plugin:java-testng:0.4.0")
release = loadPlugin(id: "org.lattejava.plugin:release-git:0.4.0")

// Plugin settings
java.settings.javaVersion = "25"
javaTestNG.settings.javaVersion = "25"

target(name: "clean", description: "Cleans the project") {
  java.clean()
}

target(name: "build", description: "Compiles and JARs the project") {
  java.compile()
  file.copy(to: "build/classes/main/org/lattejava/json/internal") {
    fileSet(dir: "src/main/java/org/lattejava/json/",
        includePatterns: [/Any.*/, /Conversion.*/, /JSON.*/, /Numbers.*/, /Skip.*/],
        excludePatterns: [/JSON.java/, /JSONCatchAll.java/, /JSONConstructor.java/, /JSONField.java/, /JSONProcessor.java/, /JSONSubtype.java/, /JSONTypeInfo.java/])
  }
  java.jar()
}

target(name: "test", description: "Runs the project's tests", dependsOn: ["build"]) {
  javaTestNG.test()
}

target(name: "int", description: "Releases a local integration build of the project", dependsOn: ["test"]) {
  dependency.integrate()
}

target(name: "release", description: "Releases a full version of the project", dependsOn: ["clean", "test"]) {
  release.release()
}

target(name: "idea", description: "Updates the IntelliJ IDEA module file") {
  idea.iml()
}

target(name: "print-dependency-tree", description: "Prints the dependency tree") {
  dependency.printFull()
}
